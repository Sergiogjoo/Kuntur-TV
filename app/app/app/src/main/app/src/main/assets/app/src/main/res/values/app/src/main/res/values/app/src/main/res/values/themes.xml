<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PeruTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/peru_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PeruTV</item>
